{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "whoami-webserver values",
  "type": "object",
  "properties": {
    "ingress": {
      "type": "object",
      "description": "Configuration de l'ingress.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "x-onyxia": {
            "readonly": true
          }
        },
        "className": {
          "type": "string",
          "default": "traefik",
          "x-onyxia": {
            "readonly": true
          }
        },
        "annotations": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string" }
        },
        "hosts": {
          "type": "array",
          "default": [{
            "host": "toto.localhost",
            "paths": [{
              "path": "/",
              "pathType": "Prefix"
            }]
          }],
          "x-onyxia": {
            "readonly": true
          },
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "default": "toto.localhost",
                "x-onyxia": {
                  "hidden": true
                }
              },
              "paths": {
                "type": "array",
                "default": [],
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "default": "/",
                      "x-onyxia": {
                        "hidden": true
                      }
                    },
                    "pathType": {
                      "type": "string",
                      "default": "Prefix",
                      "x-onyxia": {
                        "hidden": true
                      }
                    }
                  },
                  "required": ["path", "pathType"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["host", "paths"],
            "additionalProperties": false
          }
        },
        "tls": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string",
                "default": ""
              },
              "hosts": {
                "type": "array",
                "default": [],
                "items": {
                  "type": "string",
                  "default": ""
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": ["enabled", "className", "annotations", "hosts", "tls"],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}