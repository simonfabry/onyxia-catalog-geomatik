{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "whoami-webserver values",
  "type": "object",
  "properties": {
    "ingress": {
      "type": "object",
      "description": "Exposition HTTP (hostname injecte par Onyxia).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "x-onyxia": { "hidden": true, "overwriteDefaultWith": "k8s.ingress" }
        },
        "hostname": {
          "type": "string",
          "default": "",
          "x-onyxia": {
            "hidden": true,
            "overwriteDefaultWith": "{{project.id}}-{{k8s.randomSubdomain}}-{{k8s.domain}}"
          }
        },
        "ingressClassName": {
          "type": "string",
          "default": "traefik",
          "x-onyxia": { "hidden": true, "overwriteDefaultWith": "{{k8s.ingressClassName}}" }
        }
      }
    }
  }
}